# Supabase Project Credentials (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq Cloud API Key for the contextual AI Coach (console.groq.com/keys)
# Omit or leave blank to use the built-in structured offline tutor fallback
GROQ_API_KEY=your-groq-api-key

# Optional: Force standalone portfolio Demo Mode without connecting Supabase
# NEXT_PUBLIC_DEMO_MODE=true
